# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES (cityprintapp.com / cPanel)
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# =============================================================================

# Security Settings
SECRET_KEY=your-super-secret-production-key-change-this
DEBUG=False
DEBUG_INVENTORY=False

# Allowed Hosts (comma-separated). Required for live; localhost works without this.
ALLOWED_HOSTS=cityprintapp.com,www.cityprintapp.com

# Session/CSRF on HTTPS (required for live so login & notifications work on all devices)
# Set to True on live server; leave unset or False on localhost.
SESSION_COOKIE_SECURE=True

# CSRF is auto-built from ALLOWED_HOSTS (https + http for each). Only add if you use a custom port:
# ADDITIONAL_CSRF_ORIGINS=https://www.yourdomain.com:8443

# =============================================================================
# DATABASE SETTINGS (MySQL/MariaDB from cPanel)
# =============================================================================
USE_MYSQL=True
DB_NAME=abgpycyd_cityprintdatabase
DB_USER=abgpycyd_cityprintuser
DB_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_PORT=3306

# =============================================================================
# EMAIL SETTINGS (Gmail with App Password)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-company@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password_here

# =============================================================================
# TWILIO SMS (for Bulk Mailing – optional)
# =============================================================================
# Get from https://console.twilio.com . Then: pip install twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# SMART DOCUMENT EXTRACTION (handwriting + layout) – optional
# =============================================================================
# Enables cloud OCR for handwritten docs and better structure. See DOCUMENT_SMART_APIS.md.
# Install: pip install google-cloud-documentai  OR  pip install azure-ai-documentintelligence
#
# --- Option A: Google Document AI ---
# 1. Go to https://console.cloud.google.com/ → enable "Document AI API"
# 2. Document AI → Processors → Create processor → "Document OCR" → note Processor ID & Location (e.g. us)
# 3. IAM → Service accounts → Create → key (JSON) → save path
# USE_SMART_EXTRACTION=1
# DOCUMENT_AI_PROJECT_ID=your-gcp-project-id
# DOCUMENT_AI_LOCATION=us
# DOCUMENT_AI_PROCESSOR_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your-service-account-key.json
#
# --- Option B: Azure Document Intelligence ---
# 1. Azure Portal → Create resource → "Document Intelligence" → create
# 2. Keys and Endpoint → copy Key 1 and Endpoint
# USE_SMART_EXTRACTION=1
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key-here

# =============================================================================
# SFU VIDEO CALL SETTINGS (mediasoup for 30-40+ participants)
# =============================================================================
# Enable SFU mode for large video calls (recommended for 6+ participants)
MEDIASOUP_ENABLED=True
MEDIASOUP_SERVER_URL=http://localhost:3001
MEDIASOUP_WS_URL=ws://localhost:3001
MEDIASOUP_AUTO_UPGRADE_LARGE_ROOMS=True
MEDIASOUP_LARGE_ROOM_THRESHOLD=6
VIDEO_CALL_MAX_PARTICIPANTS=50
